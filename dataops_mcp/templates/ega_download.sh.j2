{% extends "base.sh.j2" %}
{% block body %}
# pyEGA3: credentials are passed only as a JSON file path (-cf). It verifies checksums itself after download.
DEST={{ dest | q }}
mkdir -p "$DEST"
# pyega3 writes pyega3_output.log to the current directory.
cd {{ log_dir | q }}
{% for acc in accessions %}
{{ pyega3 | q }} -c {{ connections }} -cf {{ credentials_path | q }} fetch {{ acc | q }} --output-dir "$DEST"
{% endfor %}
{% endblock %}
