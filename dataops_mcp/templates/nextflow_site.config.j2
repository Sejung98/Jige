// Generated by Jige at {{ generated_at }}
// Site settings only (scheduler/container cache). Analysis parameters are in params.yaml.
process {
    executor = '{{ executor }}'
{% if queue %}
    queue = '{{ queue }}'
{% endif %}
{% if cluster_options %}
    clusterOptions = '{{ cluster_options }}'
{% endif %}
{% if executor == 'local' %}
    // Running on a login/transfer node: cap task resources at this job's allocation
    resourceLimits = [ cpus: {{ local_cpus }}, memory: '{{ local_memory }}' ]
{% endif %}
}

executor {
    queueSize = {{ queue_size }}
{% if executor == 'local' %}
    cpus = {{ local_cpus }}
    memory = '{{ local_memory }}'
{% endif %}
}

{% if container in ('singularity', 'apptainer') %}
{{ container }} {
    cacheDir = '{{ container_cache }}'
}
{% endif %}
{% if extra_include %}

includeConfig '{{ extra_include }}'
{% endif %}
