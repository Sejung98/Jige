{% extends "base.sh.j2" %}
{% block body %}
# GDC Data Transfer Tool: verifies file md5 after download by default (--no-file-md5sum is not used).
# Output layout: <DEST>/<file UUID>/<file name>
DEST={{ dest | q }}
MANIFEST={{ manifest | q }}
mkdir -p "$DEST"
{{ gdc_client | q }} download \
  --manifest "$MANIFEST" \
  --dir "$DEST" \
  --n-processes {{ n_processes }} \
  --retry-amount {{ retry_amount }} \
  --log-file {{ client_log | q }}{% if token_path %} \
  --token-file {{ token_path | q }}{% endif %}

{% endblock %}
