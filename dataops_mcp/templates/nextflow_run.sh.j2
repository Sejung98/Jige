{% extends "base.sh.j2" %}
{% block body %}
{% if container in ('singularity', 'apptainer') %}
export NXF_SINGULARITY_CACHEDIR={{ container_cache | q }}
export NXF_APPTAINER_CACHEDIR={{ container_cache | q }}
{% endif %}
{% if offline %}
# Compute nodes have no internet, so pipelines/containers must be fetched beforehand with the prefetch script.
export NXF_OFFLINE=true
{% endif %}
export NXF_ANSI_LOG=false
mkdir -p {{ outdir | q }} {{ work_dir | q }} {{ launch_dir | q }}
# Use a fixed launch directory so the -resume cache (.nextflow/) is kept.
cd {{ launch_dir | q }}
{{ nextflow | q }} run nf-core/{{ pipeline }} \
  -r {{ version }} \
  -profile {{ profile }} \
  -c {{ site_config | q }} \
  -params-file {{ params_file | q }} \
  -work-dir {{ work_dir | q }} \
  -resume
{% endblock %}
