{% extends "base.sh.j2" %}
{% block body %}
# Large checksum verification runs as a job, not inside the MCP tool.
cd {{ dest | q }}
: > {{ report | q }}
RC=0
{% for algo, path in lists.items() %}
{{ algo }}sum -c {{ path | q }} >> {{ report | q }} 2>&1 || RC=1
{% endfor %}
if [ "$RC" -ne 0 ]; then
  echo "[dataops] checksum mismatches or missing files: {{ report }}"
  exit 1
fi
{% endblock %}
